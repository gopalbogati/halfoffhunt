{
  "minimum_votes": 3,
  "max_alerts_per_run": 6,
  "rules": [
    {
      "name": "Laptops",
      "pattern": "\\b(laptops?|notebooks?|macbook|thinkpad|ideapad|vivobook|zenbook|omnibook|chromebook|legion [579]|yoga slim)\\b",
      "exclude": "\\b(sleeve|stand|bag|case|charger|dock|screen protector)\\b",
      "minimum_price": 75
    },
    {
      "name": "PS5 consoles",
      "pattern": "(?=.*\\b(ps5|playstation\\s*5)\\b)(?=.*\\b(console|slim|pro|digital|disc)\\b)",
      "exclude": "\\b(controller|dualsense|headset|cover|stand|charging|skin|disc drive)\\b",
      "minimum_price": 250
    },
    {
      "name": "Gaming accessories",
      "pattern": "\\b(dualsense|ps5|playstation\\s*5|xbox|nintendo switch|steam deck|rog ally)\\b",
      "exclude": "",
      "minimum_price": 10
    },
    {
      "name": "PC parts & monitors",
      "pattern": "\\b(rtx\\s*\\d{4}|rx\\s*\\d{4}|ryzen|core ultra|ssd|nvme|ddr[45]|monitor)\\b",
      "exclude": "\\b(cable|adapter|mount|stand)\\b",
      "minimum_price": 30
    },
    {
      "name": "Phones & tablets",
      "pattern": "\\b(iphone|ipad|galaxy|pixel|tablets?|smartphones?)\\b",
      "exclude": "\\b(case|cover|screen protector|cable|charger)\\b",
      "minimum_price": 50
    },
    {
      "name": "Audio & wearables",
      "pattern": "\\b(headphones?|earbuds?|airpods?|soundbar|smartwatch|apple watch|garmin)\\b",
      "exclude": "\\b(case|cover|strap|band only)\\b",
      "minimum_price": 20
    },
    {
      "name": "Cameras & smart home",
      "pattern": "\\b(mirrorless|dslr|gopro|camera|doorbell|router|mesh wi-?fi|smart tv|oled tv)\\b",
      "exclude": "\\b(case|cover|screen protector|cable|mount)\\b",
      "minimum_price": 30
    },
    {
      "name": "Desktop PCs",
      "pattern": "\\b(desktop|gaming pc|mini pc|mini-pc|optiplex|thinkcentre|mac mini|imac)\\b",
      "exclude": "\\b(case only|desk mat|wallpaper|mount)\\b",
      "minimum_price": 75
    },
    {
      "name": "Storage & hard drives",
      "pattern": "\\b(hard drives?|hard disks?|hdd|ssd|nvme|nas|ironwolf|exos|wd elements|wd red|wd black|wd blue|sandisk extreme|seagate expansion)\\b",
      "exclude": "\\b(enclosure|caddy|adapter|cable|dock|mount)\\b",
      "minimum_price": 10
    },
    {
      "name": "PS5 games",
      "pattern": "\\b(ps5|playstation\\s*5)\\b",
      "exclude": "\\b(console|controller|dualsense|headset|cover|stand|charg\\w*|skin|disc drive|ssd|nvme|portal|pro|slim|remote|cable|adapter)\\b",
      "minimum_price": 0
    },
    {
      "name": "Trade-in & buyback",
      "pattern": "(?=.*\\b(trade[ -]?in|buy[ -]?back|sell your)\\b)(?=.*\\b(iphone|ipad|phone|samsung|pixel|galaxy|macbook|laptop|computer|console|ps5|playstation|xbox|device|devices|tablet|watch|camera|airpods)\\b)",
      "exclude": "",
      "minimum_price": 0,
      "allow_no_price": true
    }
  ]
}
